{
  "name": "asql-urban-mobility",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 -p 3000",
    "lint": "eslint src/app/layout.tsx src/app/page.tsx src/app/api/health/route.ts src/app/api/traffic/route.ts src/components/traffic/traffic-app.tsx src/components/shared/sql-block.tsx src/lib/utils.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/traffic-core.test.mjs tests/traffic-queries.test.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.mjs",
    "data:import": "node --env-file-if-exists=.env scripts/import-dataset.mjs",
    "data:download": "python scripts/download-dataset.py",
    "verify:database": "node --env-file-if-exists=.env scripts/verify-database.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "mysql2": "^3.15.3",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.0.0"
  }
}
